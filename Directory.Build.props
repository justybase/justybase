<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Keep the default .NET analyzer set readable. Critical rules below remain explicit. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CS warnings for nullability -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8600;CS8602;CS8603;CS8625</WarningsAsErrors>
    <!-- CA warnings - critical for memory leaks and disposal (Phase 4.1) -->
    <WarningsAsErrors>$(WarningsAsErrors);CA2000;CA2213;CA2001;CA2200</WarningsAsErrors>
    <!--
      NuGet audit availability is external to compilation. Keep a failed audit
      endpoint as a visible warning, but do not let it block local/offline builds.
      Vulnerability warnings remain enabled and are not suppressed here.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>

    <!--
      Set EnableAi=false to build the application without the optional AI
      components and their heavy NuGet dependencies (GitHub.Copilot.SDK,
      Microsoft.Extensions.AI, OpenAI, embedded llama.cpp model management).
      The no-AI build keeps the lightweight JustyBase.Ai.Contracts project only.
    -->
    <EnableAi Condition="'$(EnableAi)' == ''">true</EnableAi>

    <!--
      .NET 11 runtime-native async (Runtime Async V2). The runtime handles async
      suspension/resumption instead of compiler-generated state machines, giving
      lower overhead and cleaner live stack traces. Supported by JIT, ReadyToRun
      and NativeAOT. Opt out per project with <EnableRuntimeAsync>false</EnableRuntimeAsync>.
      https://learn.microsoft.com/dotnet/core/whats-new/dotnet-11/runtime#runtime-async
    -->
    <EnableRuntimeAsync Condition="'$(EnableRuntimeAsync)' == ''">true</EnableRuntimeAsync>
    <!-- A leading separator is harmless to the compiler when Features is still empty. -->
    <Features Condition="'$(EnableRuntimeAsync)' == 'true'">$(Features);runtime-async=on</Features>

    <!-- These sibling checkouts are required for local builds and CI. -->
    <JustyBaseLibrariesRoot Condition="'$(JustyBaseLibrariesRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</JustyBaseLibrariesRoot>
    <JustyBaseLocalNetezzaProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Netezza\JustyBase.Netezza.csproj</JustyBaseLocalNetezzaProject>
    <JustyBaseLocalNetezzaSqlParserProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaSqlParser.csproj</JustyBaseLocalNetezzaSqlParserProject>
    <JustyBaseLocalNetezzaDdlProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaDdl\JustyBase.NetezzaDdl.csproj</JustyBaseLocalNetezzaDdlProject>
    <JustyBaseLocalNetezzaCatalogSqlProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.NetezzaCatalogSql\JustyBase.NetezzaCatalogSql.csproj</JustyBaseLocalNetezzaCatalogSqlProject>
    <JustyBaseLocalCoreProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Core\JustyBase.Core.csproj</JustyBaseLocalCoreProject>
    <JustyBaseLocalImportExportProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.ImportExport\JustyBase.ImportExport.csproj</JustyBaseLocalImportExportProject>
    <JustyBaseLocalAiContractsProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Ai.Contracts\JustyBase.Ai.Contracts.csproj</JustyBaseLocalAiContractsProject>
    <JustyBaseLocalAiProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Ai\JustyBase.Ai.csproj</JustyBaseLocalAiProject>
    <JustyBaseLocalAiEmbeddedProject>$(JustyBaseLibrariesRoot)JustyBase.NetezzaSql\JustyBase.Ai.Embedded\JustyBase.Ai.Embedded.csproj</JustyBaseLocalAiEmbeddedProject>
    <JustyBaseLocalUCanAccessProject>$(JustyBaseLibrariesRoot)JustyBase.UCanAccessCs\src\UCanAccess\UCanAccess.csproj</JustyBaseLocalUCanAccessProject>
    <JustyBaseLocalUCanAccessCryptoProject>$(JustyBaseLibrariesRoot)JustyBase.UCanAccessCs\src\UCanAccess.AccessCrypto\UCanAccess.AccessCrypto.csproj</JustyBaseLocalUCanAccessCryptoProject>
    <!-- Managed DB2 driver and IBM.Data.Db2 compatibility API, restored from NuGet. -->
    <JustyBaseDb2PackageVersion Condition="'$(JustyBaseDb2PackageVersion)' == ''">0.1.0-alpha.1</JustyBaseDb2PackageVersion>

  </PropertyGroup>
</Project>
