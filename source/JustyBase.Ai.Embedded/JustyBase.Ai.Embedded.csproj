<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JustyBase.Ai.Embedded</RootNamespace>
    <Description>Embedded llama.cpp (llama-server) GGUF model management for FIM inline completion and AI chat.</Description>
    <!-- Pure managed code (HttpClient, Process, System.Text.Json source-gen). No native packages. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
