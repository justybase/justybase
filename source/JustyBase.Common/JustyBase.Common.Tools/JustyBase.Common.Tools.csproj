<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="SpreadSheetTasks" Version="1.0.0" />
    <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' == 'true'">
    <ProjectReference Include="$(JustyBaseLocalImportExportProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
    <PackageReference Include="JustyBase.ImportExport" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--<ProjectReference Include="..\..\..\..\PublicNuget\SpreadSheetTasks\source\SpreadSheetTasks\SpreadSheetTasks.csproj" />-->
    <ProjectReference Include="..\..\JustyBase.PluginCommon\JustyBase.PluginCommon.csproj" />
  </ItemGroup>

</Project>
