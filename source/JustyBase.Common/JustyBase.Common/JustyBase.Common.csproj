<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<TrimmerRootAssembly Include="JustyBase.Common" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustyBase.Common.Tools\JustyBase.Common.Tools.csproj" />
    <ProjectReference Include="$(JustyBaseLocalAiProject)" Condition="'$(UseLocalJustyBaseLibraries)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
    <PackageReference Include="JustyBase.Ai" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
  </ItemGroup>
</Project>
