<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' == 'true'">
        <ProjectReference Include="$(JustyBaseLocalImportExportProject)" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
        <PackageReference Include="JustyBase.ImportExport" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
    </ItemGroup>

</Project>
