<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- <DefineConstants>ORACLE;POSTGRES;MYSQL</DefineConstants> -->
		<!-- Static plugin wiring (NativeAOT publishes cannot load plugins dynamically).
		     EnableDb2Plugin=true adds the DB2 define + DB2Plugin project reference.
		     Debug builds (F5 in Visual Studio) enable DB2 automatically; release scripts
		     select the required AOT or self-contained database variant explicitly. -->
		<EnableDb2Plugin Condition="'$(EnableDb2Plugin)' == '' and '$(Configuration)' == 'Debug'">true</EnableDb2Plugin>
		<EnableDb2Plugin Condition="'$(EnableDb2Plugin)' == '' and '$(Configuration)' != 'Debug'">false</EnableDb2Plugin>
		<DefineConstants Condition="'$(EnableDb2Plugin)' == 'true'">$(DefineConstants);DB2</DefineConstants>
		<OutputType>WinExe</OutputType>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<TargetFramework>net10.0</TargetFramework>
		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<!-- Migrate the UI application to flow analysis in batches; annotations keep this build usable meanwhile. -->
		<Nullable>annotations</Nullable>
		<WarningsAsErrors>$(WarningsAsErrors);CA2200</WarningsAsErrors>
		<!-- Views are constructed through DI with parameterized constructors; Avalonia's runtime-loader check is not applicable. -->
		<NoWarn>$(NoWarn);AVLN3001</NoWarn>
		<ApplicationIcon>Assets\Icon2.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<Copyright>JustyBaseTeam</Copyright>
		<RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<!--<PublishReadyToRun>false</PublishReadyToRun>
		<SelfContained>false</SelfContained>-->
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(EnableAOT)' == 'true'">
    <PublishAot>true</PublishAot>
    <TrimMode>link</TrimMode>
    <DefineConstants>$(DefineConstants);AOT</DefineConstants>
    <!--https://docs.avaloniaui.net/docs/deployment/native-aot-->
    <!-- macOS-specific AOT settings for linker compatibility -->
    <IlcExportUnmanagedEntrypoints>true</IlcExportUnmanagedEntrypoints>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SelfContained>true</SelfContained>
	</PropertyGroup>
	<Target Name="ValidateJustyBasePublishConfiguration" BeforeTargets="Publish">
		<Error Condition="'$(EnableAOT)' == 'true' and '$(EnableDb2Plugin)' == 'true'"
		       Text="DB2Plugin is not compatible with NativeAOT. Use the self-contained DB2 variant with EnableAOT=false." />
		<Error Condition="'$(EnableAOT)' == 'true' and ('$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64')"
		       Text="NativeAOT is not supported for macOS release artifacts. Use the self-contained macOS variant." />
	</Target>
	<ItemGroup>
		<TrimmerRootAssembly Include="JustyBase" />
		<TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />

		<!--<TrimmerRootAssembly Include="Avalonia.Themes.Default" />-->

		<!--<TrimmerRootAssembly Include="Avalonia.MarkupExtension" />
		<TrimmerRootAssembly Include="Dock.Model" />
		<TrimmerRootAssembly Include="Dock.Model.Mvvm" />
		<TrimmerRootAssembly Include="Dock.Avalonia" />-->
		

		<TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />

		<!-- The IBM DB2 provider relies on reflection for provider type maps; keep it whole under AOT. -->
		<TrimmerRootAssembly Include="DB2Plugin" Condition="'$(Configuration)' == 'Release' and '$(EnableAOT)' == 'true' and '$(EnableDb2Plugin)' == 'true'" />
		<TrimmerRootAssembly Include="IBM.Data.Db2" Condition="'$(Configuration)' == 'Release' and '$(EnableAOT)' == 'true' and '$(EnableDb2Plugin)' == 'true'" />

		<!--<TrimmerRootAssembly Include="JustyBase.Common"/>-->
		<!--<<assembly fullname="Dock.ProportionalStackPanel" preserve="All" />
		<assembly fullname="AvaloniaEdit" preserve="All" />
		<assembly fullname="Avalonia.Controls.DataGrid" preserve="All" />
		-->
	</ItemGroup>
	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
	  <AvaloniaXaml Remove="publish\**" />
	  <AvaloniaXaml Remove="Releases\**" />
	  <Compile Remove="publish\**" />
	  <Compile Remove="Releases\**" />
	  <EmbeddedResource Remove="publish\**" />
	  <EmbeddedResource Remove="Releases\**" />
	  <None Remove="publish\**" />
	  <None Remove="Releases\**" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Assets\countdown.json" />
		<None Remove="Assets\frog.json" />
		<None Remove="Assets\gears.json" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Assets\Icon2.ico" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="DiffPlex" Version="1.9.0" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.3" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
		<PackageReference Include="ProDataGrid" Version="12.0.5" />
		<PackageReference Include="Velopack" Version="1.2.0" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Labs.Lottie" Version="12.0.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Dock.Model.Mvvm" Version="12.1.0" />
		<PackageReference Include="Dock.Model" Version="12.1.0" />
		<PackageReference Include="Dock.Avalonia" Version="12.1.0" />
		<PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
		<PackageReference Include="LiveMarkdown.Avalonia" Version="2.2.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<!-- Override Microsoft.Data.Sqlite's vulnerable SQLite native dependency. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
		<PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.5" />
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release' and '$(EnableAOT)' == 'true' and '$(EnableAOTCompress)' == 'true'">
		<PackageReference Include="PublishAotCompressed" Version="1.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\CustomListBox.axaml.cs">
			<DependentUpon>CustomListBox.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\SqlParameterWindow.axaml.cs">
			<DependentUpon>SqlParameterWindow.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\AddNewConnectionView.axaml.cs">
			<DependentUpon>AddNewConnectionView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\LogToolView.axaml.cs">
			<DependentUpon>c.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\DbSchemaView.axaml.cs">
			<DependentUpon>DbSchemaView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\SqlResultsView.axaml.cs">
			<DependentUpon>SqlResultsView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\SchemaSearchView.axaml.cs">
			<DependentUpon>SchemaSearchView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\VariablesView.axaml.cs">
			<DependentUpon>VariablesView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\JustyBase.Common\JustyBase.Common\JustyBase.Common.csproj" />
		<ProjectReference Include="..\JustyBase.PluginBase\JustyBase.PluginBase.csproj" />
		<ProjectReference Include="..\JustyBase.Public.Lib\JustyBase.Public.Lib.csproj" />
		
		<ProjectReference Include="..\Plugins\NetezzaDotnetPlugin\NetezzaDotnetPlugin.csproj" />
		<ProjectReference Include="..\SqlEditor.Avalonia\SqlEditor.Avalonia.csproj" />
		<ProjectReference Include="..\JustyBase.Ai.Embedded\JustyBase.Ai.Embedded.csproj" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' == 'true'">
		<ProjectReference Include="$(JustyBaseLocalNetezzaSqlParserProject)" />
		<ProjectReference Include="$(JustyBaseLocalNetezzaProject)" />
		<ProjectReference Include="$(JustyBaseLocalNetezzaDdlProject)" />
		<ProjectReference Include="$(JustyBaseLocalNetezzaCatalogSqlProject)" />
		<ProjectReference Include="$(JustyBaseLocalCoreProject)" />
		<ProjectReference Include="$(JustyBaseLocalImportExportProject)" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
		<PackageReference Include="JustyBase.NetezzaSqlParser" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.Netezza" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.NetezzaDdl" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.NetezzaCatalogSql" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.Core" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.ImportExport" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('MYSQL'))">
		<ProjectReference Include="..\Plugins\MySqlPlugin\MySqlPlugin.csproj" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('POSTGRES'))">
		<ProjectReference Include="..\Plugins\PostgresPlugin\PostgresPlugin.csproj" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('ORACLE'))">
		<ProjectReference Include="..\Plugins\OraclePlugin\OraclePlugin.csproj" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('DB2'))">
		<ProjectReference Include="..\Plugins\DB2Plugin\DB2Plugin.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="JustyBase.Tests" />
	</ItemGroup>
</Project>
