<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:JustyBase.ViewModels"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="309"
		Width="600"
		Height="371"
        x:Class="JustyBase.SplashWindow"
        Title="SplashWindow"
		Topmost="True"
		ExtendClientAreaToDecorationsHint="True"
		ShowInTaskbar="False"
        WindowDecorations="None"
		WindowStartupLocation="CenterScreen">
	<!--
	Background="Transparent"
	WindowDecorations="None"-->
	<Panel>
		<!--BorderBrush="Black"-->
		<!--<Border BorderThickness="1">-->
			<!--<TextBlock FontWeight="Bold"
                       FontSize="30"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">Starting...</TextBlock>-->
		
		<!--<Viewbox Stretch="None">-->
			<ContentControl Name="LottieHost"
				HorizontalAlignment="Center"
				VerticalAlignment="Center" />
			<Image Name="StaticSplash"
				Source="avares://JustyBase/Assets/Icon2.png"
				Width="128"
				Height="128"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsVisible="False" />
		<!--</Viewbox>-->
		<!--</Border>-->
	</Panel>
</Window>
