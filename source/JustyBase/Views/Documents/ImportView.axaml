<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="JustyBase.Views.Documents.ImportView"
			 xmlns:vm="using:JustyBase.ViewModels.Documents"
			 xmlns:m2="using:JustyBase.Common.Models"
			 xmlns:sys="using:System"
			 x:DataType="vm:ImportViewModel">
	<UserControl.Styles>
		<Style Selector="ComboBox">
			<Setter Property="MinWidth" Value="230"/>
			<Setter Property="MaxWidth" Value="230"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Padding" Value="6 3 0 0"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="MinHeight" Value="26"/>
			<Setter Property="MaxWidth" Value="230"/>
		</Style>
	</UserControl.Styles>
	<Grid ColumnDefinitions="340,*">
		<!-- LEFT RAIL -->
		<Border Grid.Column="0" BorderThickness="0 0 1 0" BorderBrush="{DynamicResource TextControlForegroundDisabled}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="10 6 6 6" Spacing="10">

					<StackPanel Spacing="4">
						<TextBlock Text="1. Source file" FontWeight="Bold"/>
						<StackPanel Orientation="Horizontal" Spacing="4">
							<TextBox Text="{Binding ImportFilepath}" MinWidth="180" MaxWidth="230" MinHeight="26"/>
							<Button Background="Transparent" Command="{Binding OpenFileForImportCommand}" IsEnabled="{Binding !IsImportRunning}">
								<PathIcon Data="M12.25 8.5C10.1789 8.5 8.49999 10.1789 8.49999 12.25V35.75C8.49999 37.8211 10.1789 39.5 12.25 39.5H35.7499C37.821 39.5 39.4999 37.8211 39.4999 35.75V27.25C39.4999 26.5596 40.0596 26 40.7499 26C41.4403 26 41.9999 26.5596 41.9999 27.25V35.75C41.9999 39.2018 39.2017 42 35.7499 42H12.25C8.79821 42 6 39.2018 6 35.75V12.25C6 8.79822 8.79821 6 12.25 6H20.75C21.4403 6 22 6.55964 22 7.25C22 7.94036 21.4403 8.5 20.75 8.5H12.25ZM27.0002 7.25C27.0002 6.55964 27.5598 6 28.2502 6H40.75C41.4404 6 42 6.55964 42 7.25V19.75C42 20.4404 41.4404 21 40.75 21C40.0597 21 39.5 20.4404 39.5 19.75V10.2676L29.1338 20.6338C28.6457 21.1219 27.8542 21.1219 27.3661 20.6338C26.8779 20.1456 26.8779 19.3542 27.3661 18.866L37.732 8.5H28.2502C27.5598 8.5 27.0002 7.94036 27.0002 7.25Z"/>
							</Button>
						</StackPanel>

						<StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsSourceEmpty}">
							<TextBlock Text="Sheets" VerticalAlignment="Center"/>
							<ComboBox ItemsSource="{Binding ExcelTabsNames}" SelectedItem="{Binding SelectedTab}" MinWidth="230">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:TabItem">
										<StackPanel Orientation="Horizontal">
											<CheckBox IsChecked="{Binding TabOk}"/>
											<TextBlock Text="{Binding TabName}" Margin="8 0 0 0"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="Options" FontWeight="Bold"/>
						<Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="All columns as text" VerticalAlignment="Center"
									ToolTip.Tip="Treat every column as text (original raw value, no type parsing)."/>
							<ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding AllColumnsAsText}"/>
							<TextBlock Grid.Row="1" Grid.Column="0" Text="Delimiter (USING)" VerticalAlignment="Center" Margin="0 2 0 0"
									ToolTip.Tip="EXTERNAL USING delimiter for Netezza named-pipe import. Use \t for tab."/>
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UsingDelimiter}" PlaceholderText="\t" MinWidth="160"/>
							<TextBlock Grid.Row="2" Grid.Column="0" Text="Encoding" VerticalAlignment="Center" Margin="0 2 0 0"/>
							<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UsingEncoding}" PlaceholderText="utf-8" MinWidth="160"/>
							<TextBlock Grid.Row="3" Grid.Column="0" Text="MAXROWS" VerticalAlignment="Center" Margin="0 2 0 0"/>
							<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UsingMaxRows}" PlaceholderText="(optional)" MinWidth="160"/>
						</Grid>
					</StackPanel>

					<StackPanel Spacing="4">
						<TextBlock Text="2. Destination" FontWeight="Bold"/>
						<Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="Connection" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ConnectionsList}" SelectedItem="{Binding SelectedConnection}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="m2:ConnectionItem">
										<StackPanel Orientation="Horizontal">
										<Image Width="16" Height="16" Source="{Binding DatabaseType, Converter={StaticResource databaseIconConverter}}"/>
											<TextBlock Text="{Binding Name}" Margin="8 0 0 0"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Grid.Row="1" Grid.Column="0" Text="Database" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DatabaseItems}" SelectedItem="{Binding SelectedDatabase}"/>
							<TextBlock Grid.Row="2" Grid.Column="0" Text="Schema" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SchemaItems}" SelectedItem="{Binding SelectedSchema}"/>
						</Grid>

						<StackPanel Orientation="Horizontal" Spacing="12">
							<RadioButton Content="Create new table" IsChecked="{Binding IsCreateNewMode}" GroupName="destMode"/>
							<RadioButton Content="Existing table" IsChecked="{Binding IsExistingMode}" GroupName="destMode"/>
						</StackPanel>

						<TextBlock Text="Table" VerticalAlignment="Center" IsVisible="{Binding IsExistingMode}"/>
						<AutoCompleteBox IsVisible="{Binding IsExistingMode}"
							  ItemsSource="{Binding TableItems}"
							  Text="{Binding SelectedTableText}"
							  FilterMode="Contains"
							  IsTextCompletionEnabled="True"
							  MinWidth="230" MaxWidth="230" Padding="6 4 0 0"/>
						<Button IsVisible="{Binding IsExistingMode}" Command="{Binding CheckCompatibilityCommand}"
								IsEnabled="{Binding !IsCheckingCompatibility}"
								HorizontalAlignment="Left" Padding="12 4">Check compatibility</Button>
						<TextBlock Text="{Binding CompatibilitySummary}" TextWrapping="Wrap"
								   IsVisible="{Binding !!CompatibilitySummary}" Foreground="IndianRed"/>
						<TextBox IsVisible="{Binding !!TabsWarningMessage}" Text="{Binding TabsWarningMessage}"
								 TextWrapping="Wrap" Height="50" IsReadOnly="True" MinWidth="280" MaxWidth="280"/>
					</StackPanel>

					<StackPanel Spacing="6">
						<TextBlock Text="3. Run" FontWeight="Bold"/>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Command="{Binding ImportStartCommand}" CommandParameter="Fast" IsEnabled="{Binding StartEnabled}">Import</Button>
							<Button Command="{Binding ImportStartCommand}" CommandParameter="WithSteps" IsEnabled="{Binding StartEnabled}">Step by step</Button>
							<Button Command="{Binding ImportStartCommand}" CommandParameter="Continue" IsEnabled="{Binding ContinueEnabled}">Continue</Button>
						</StackPanel>
						<TextBlock Text="{Binding DetectionStatus}" TextWrapping="Wrap" IsVisible="{Binding !!DetectionStatus}" Opacity="0.8"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- MAIN AREA -->
		<Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
			<Border Grid.Row="0" BorderThickness="0 0 0 1" BorderBrush="{DynamicResource TextControlForegroundDisabled}" Padding="8 4">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Command="{Binding ApplyAllAsTextCommand}" Padding="10 3">All as text</Button>
					<Button Command="{Binding RevertAllToDetectedCommand}" Padding="10 3">Revert to detected</Button>
					<TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" VerticalAlignment="Center"
							   Foreground="IndianRed"/>
				</StackPanel>
			</Border>

			<TextBlock Grid.Row="1" Text="Columns (detected types; click a cell to override)" Margin="8 6" Opacity="0.8"/>
			<DataGrid Grid.Row="2" IsReadOnly="False" ItemsSource="{Binding ColumnsInGrid}" AutoGenerateColumns="False"
					  CanUserSortColumns="False" CanUserReorderColumns="False" Margin="8 0">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Name" IsReadOnly="True" Binding="{Binding ColumnName}"/>
					<DataGridTextColumn Header="Detected type" IsReadOnly="True" Binding="{Binding DetectedType}"/>
					<DataGridTemplateColumn Header="Selected type" IsReadOnly="False" Width="*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:ColumnInGrid">
								<StackPanel Orientation="Horizontal" Margin="6 0">
									<TextBlock Text="{Binding SelectedType}" VerticalAlignment="Center"/>
									<TextBlock Text=" (changed)" IsVisible="{Binding IsOverridden}" Opacity="0.75"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate x:DataType="vm:ColumnInGrid">
								<ComboBox ItemsSource="{Binding AvailableChoices}" SelectedItem="{Binding SelectedChoice}"
										  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="140">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="vm:TypeChoice">
											<TextBlock Text="{Binding Label}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Width="Auto">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:ColumnInGrid">
								<Button Content="Reset" Command="{Binding ResetToDetectedCommand}" Padding="8 0" MinHeight="22" Margin="4 0"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Header="Validation" Width="2*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="vm:ColumnInGrid">
								<TextBox Text="{Binding ValidationError}"
										 IsVisible="{Binding HasValidationError}"
										 TextWrapping="Wrap"
										 Foreground="IndianRed"
										 VerticalAlignment="Center"
										 Margin="4 0" IsReadOnly="True" Background="Transparent" BorderThickness="0"
										 CaretBrush="Transparent" SelectionBrush="DodgerBlue"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>

		<Border Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource TextControlForegroundDisabled}"
				Margin="8 8 8 0" CornerRadius="4" Padding="8 4">
			<TextBlock Text="Preview" FontWeight="SemiBold" Opacity="0.8"/>
		</Border>
		<DataGrid Name="previewDataGrid" Grid.Row="4" Margin="8 0 8 8" AutoGenerateColumns="False"
				  MinHeight="80" MaxHeight="160" BorderThickness="1"
				  BorderBrush="{DynamicResource TextControlForegroundDisabled}"/>

		<!-- Progress section -->
		<Border Grid.Row="5" IsVisible="{Binding IsProgressVisible}"
				BorderThickness="1" BorderBrush="{DynamicResource TextControlForegroundDisabled}" Margin="8 0 8 8"
				Padding="8" CornerRadius="4">
			<StackPanel Spacing="8">
				<TextBlock Text="Import progress" FontWeight="SemiBold"/>
				<ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
							 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
				<TextBlock Text="{Binding ProgressStatus}" TextWrapping="Wrap" Opacity="0.8"/>
				<ListBox ItemsSource="{Binding ImportLog}" MaxHeight="120" MinHeight="60">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ImportLogRow">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Opacity="0.7"/>
								<TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<TextBox Text="{Binding ResultSql}" IsReadOnly="True" TextWrapping="Wrap"
						 IsVisible="{Binding !!ResultSql}" FontFamily="Consolas, monospace"/>
				<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !!ResultSql}">
					<Button Command="{Binding CopySelectCommand}" Padding="10 3">Copy SELECT</Button>
					<Button Command="{Binding InsertSelectIntoEditorCommand}" Padding="10 3">Insert SELECT into editor</Button>
				</StackPanel>
			</StackPanel>
		</Border>
		</Grid>
	</Grid>
</UserControl>
