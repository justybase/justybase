<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="JustyBase.Views.Documents.ImportView"
             xmlns:vm="using:JustyBase.ViewModels.Documents"
             xmlns:m2="using:JustyBase.Common.Models"
             x:DataType="vm:ImportViewModel">
    <UserControl.Styles>
        <Style Selector="Border.import-card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.import-card.grid-card">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Border.step-badge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.step-number">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.card-subtitle">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="1 0 0 0" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.status-pill">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="10 3" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.status-pill.ready">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
        </Style>

        <Style Selector="Border.status-pill.running">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}" />
        </Style>

        <Style Selector="Button.primary-action">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16 7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.secondary-action">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12 5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.ghost-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8 3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style Selector="Button.ghost-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Expander.import-expander">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.import-expander > StackPanel">
            <Setter Property="Margin" Value="0 8 0 2" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <Style Selector="DataGrid.import-grid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        </Style>

        <Style Selector="DataGrid.import-grid DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.empty-state">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>

        <Style Selector="Border.panel-header">
            <Setter Property="Padding" Value="14 10" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="14">
        <!-- Page header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="44" Height="44" CornerRadius="11"
                    Background="{DynamicResource SystemAccentColorLight3Brush}">
                <PathIcon Width="22" Height="22"
                          Foreground="{DynamicResource SystemAccentColorBrush}"
                          Data="M12 2.75C12.41 2.75 12.75 3.09 12.75 3.5V13.19L16.22 9.72C16.51 9.43 16.98 9.43 17.27 9.72C17.56 10.01 17.56 10.48 17.27 10.77L12.53 15.51C12.24 15.8 11.76 15.8 11.47 15.51L6.73 10.77C6.44 10.48 6.44 10.01 6.73 9.72C7.02 9.43 7.49 9.43 7.78 9.72L11.25 13.19V3.5C11.25 3.09 11.59 2.75 12 2.75ZM4.75 15C5.16 15 5.5 15.34 5.5 15.75V19.25C5.5 19.66 5.84 20 6.25 20H17.75C18.16 20 18.5 19.66 18.5 19.25V15.75C18.5 15.34 18.84 15 19.25 15C19.66 15 20 15.34 20 15.75V19.25C20 20.49 18.99 21.5 17.75 21.5H6.25C5.01 21.5 4 20.49 4 19.25V15.75C4 15.34 4.34 15 4.75 15Z" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Load a spreadsheet or delimited file into a database table."
                           Classes="muted" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Border Classes="status-pill" IsVisible="{Binding IsSourceEmpty}">
                    <TextBlock Text="No source" FontSize="11" Opacity="0.7" />
                </Border>
                <Border Classes="status-pill ready" IsVisible="{Binding !IsSourceEmpty}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemAccentColorBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Source ready" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Classes="status-pill running" IsVisible="{Binding IsImportRunning}">
                    <TextBlock Text="Importing…" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="14">
            <!-- Setup rail -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0 0 10 0">
                    <StackPanel Spacing="10">
                        <!-- 1. Source -->
                        <Border Classes="import-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="step-badge">
                                        <TextBlock Classes="step-number" Text="1" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="card-title" Text="Source" />
                                        <TextBlock Classes="card-subtitle"
                                                   Text="Choose an Excel workbook or a delimited text file." />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ImportFilepath}"
                                             PlaceholderText="Path to the source file"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding OpenFileForImportCommand}"
                                            IsEnabled="{Binding !IsImportRunning}"
                                            Classes="secondary-action"
                                            ToolTip.Tip="Browse for a source file">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource OpenDirectorySymbol}"
                                                      Width="16" Height="16" />
                                            <TextBlock Text="Browse" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="6" IsVisible="{Binding !IsSourceEmpty}">
                                    <TextBlock Classes="field-label" Text="Worksheet" />
                                    <ComboBox ItemsSource="{Binding ExcelTabsNames}"
                                              SelectedItem="{Binding SelectedTab}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TabItem">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox IsChecked="{Binding TabOk}" />
                                                    <TextBlock Text="{Binding TabName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding !IsSourceEmpty}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0"
                                                   Text="All columns as text"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   ToolTip.Tip="Skip type inference and keep every raw value as text." />
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding AllColumnsAsText}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <Expander Classes="import-expander" Header="Delimited text options">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Classes="field-label" Text="Delimiter (USING)" />
                                                    <TextBox Text="{Binding UsingDelimiter}"
                                                             PlaceholderText="\t" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Classes="field-label" Text="Encoding" />
                                                    <TextBox Text="{Binding UsingEncoding}"
                                                             PlaceholderText="utf-8" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="field-label" Text="MAXROWS" />
                                                <TextBox Text="{Binding UsingMaxRows}"
                                                         PlaceholderText="(optional; leave empty for all rows)" />
                                            </StackPanel>
                                            <TextBlock Classes="muted" FontSize="11"
                                                       Text="Delimiter is used by the Netezza EXTERNAL USING clause when the import pipe is written." />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Destination -->
                        <Border Classes="import-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="step-badge">
                                        <TextBlock Classes="step-number" Text="2" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="card-title" Text="Destination" />
                                        <TextBlock Classes="card-subtitle"
                                                   Text="Pick the connection, database and target table." />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="8" ColumnSpacing="10">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Connection"
                                               Classes="field-label" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding ConnectionsList}"
                                              SelectedItem="{Binding SelectedConnection}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="m2:ConnectionItem">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Image Width="16" Height="16" Stretch="Uniform"
                                                           Source="{Binding DatabaseType, Converter={StaticResource databaseIconConverter}}" />
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database"
                                               Classes="field-label" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DatabaseItems}"
                                              SelectedItem="{Binding SelectedDatabase}"
                                              HorizontalAlignment="Stretch" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Schema"
                                               Classes="field-label" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding SchemaItems}"
                                              SelectedItem="{Binding SelectedSchema}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Border Grid.Column="0" Padding="8" CornerRadius="7"
                                            BorderThickness="1"
                                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
                                        <RadioButton IsChecked="{Binding IsCreateNewMode}"
                                                     GroupName="destMode"
                                                     HorizontalContentAlignment="Stretch"
                                                     ToolTip.Tip="Build a table from the detected columns.">
                                            <TextBlock Text="Create new table" FontWeight="SemiBold" />
                                        </RadioButton>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8" CornerRadius="7"
                                            BorderThickness="1"
                                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
                                        <RadioButton IsChecked="{Binding IsExistingMode}"
                                                     GroupName="destMode"
                                                     HorizontalContentAlignment="Stretch"
                                                     ToolTip.Tip="Insert rows into an existing target table.">
                                            <TextBlock Text="Existing table" FontWeight="SemiBold" />
                                        </RadioButton>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="6" IsVisible="{Binding IsExistingMode}">
                                    <TextBlock Classes="field-label" Text="Target table" />
                                    <AutoCompleteBox ItemsSource="{Binding TableItems}"
                                                     Text="{Binding SelectedTableText}"
                                                     FilterMode="Contains"
                                                     IsTextCompletionEnabled="True"
                                                     HorizontalAlignment="Stretch"
                                                     Padding="8 5" />
                                    <Button Command="{Binding CheckCompatibilityCommand}"
                                            IsEnabled="{Binding !IsCheckingCompatibility}"
                                            Classes="secondary-action"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource FilterIcon}"
                                                      Width="14" Height="14" />
                                            <TextBlock Text="Check compatibility" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="{Binding CompatibilitySummary}"
                                           IsVisible="{Binding HasCompatibilityErrors}"
                                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                           TextWrapping="Wrap" FontSize="11" />
                                <TextBlock Text="{Binding CompatibilitySummary}"
                                           IsVisible="{Binding !HasCompatibilityErrors}"
                                           Classes="muted" FontSize="11" />

                                <TextBox Text="{Binding TabsWarningMessage}"
                                         IsVisible="{Binding !!TabsWarningMessage}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MinHeight="54" MaxHeight="110" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Run card -->
                <Border Grid.Row="1" Classes="import-card">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="step-badge">
                                <TextBlock Classes="step-number" Text="3" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Classes="card-title" Text="Run import" />
                                <TextBlock Classes="card-subtitle"
                                           Text="Start the import when the source and target look right." />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Classes="accent primary-action"
                                    Command="{Binding ImportStartCommand}"
                                    CommandParameter="Fast"
                                    IsEnabled="{Binding StartEnabled}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource ChevronDownPath}"
                                              Width="13" Height="13" />
                                    <TextBlock Text="Import" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="secondary-action"
                                    Command="{Binding ImportStartCommand}"
                                    CommandParameter="WithSteps"
                                    IsEnabled="{Binding StartEnabled}">
                                Step by step
                            </Button>
                        </Grid>

                        <Button Command="{Binding ImportStartCommand}"
                                CommandParameter="Continue"
                                IsVisible="{Binding ContinueEnabled}"
                                Classes="secondary-action"
                                HorizontalAlignment="Stretch"
                                Content="Continue" />

                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !!DetectionStatus}">
                            <ProgressBar IsVisible="{Binding IsDetecting}"
                                         IsIndeterminate="True"
                                         Width="56" Height="3"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DetectionStatus}"
                                       Classes="muted" FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <ProgressBar IsVisible="{Binding IsValidating}"
                                     IsIndeterminate="True"
                                     Height="3" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Columns / preview -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Border Grid.Row="0" Grid.RowSpan="3" Classes="import-card empty-state"
                        VerticalAlignment="Stretch"
                        IsVisible="{Binding IsSourceEmpty}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="12" MaxWidth="430" Margin="24">
                        <Border Width="62" Height="62" CornerRadius="16"
                                Background="{DynamicResource SystemAccentColorLight3Brush}"
                                BorderBrush="{DynamicResource SystemAccentColorBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <PathIcon Width="30" Height="30"
                                      Foreground="{DynamicResource SystemAccentColorBrush}"
                                      Data="M12 2.75C12.41 2.75 12.75 3.09 12.75 3.5V13.19L16.22 9.72C16.51 9.43 16.98 9.43 17.27 9.72C17.56 10.01 17.56 10.48 17.27 10.77L12.53 15.51C12.24 15.8 11.76 15.8 11.47 15.51L6.73 10.77C6.44 10.48 6.44 10.01 6.73 9.72C7.02 9.43 7.49 9.43 7.78 9.72L11.25 13.19V3.5C11.25 3.09 11.59 2.75 12 2.75ZM4.75 15C5.16 15 5.5 15.34 5.5 15.75V19.25C5.5 19.66 5.84 20 6.25 20H17.75C18.16 20 18.5 19.66 18.5 19.25V15.75C18.5 15.34 18.84 15 19.25 15C19.66 15 20 15.34 20 15.75V19.25C20 20.49 18.99 21.5 17.75 21.5H6.25C5.01 21.5 4 20.49 4 19.25V15.75C4 15.34 4.34 15 4.75 15Z" />
                        </Border>
                        <TextBlock Text="Nothing to preview yet" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Choose an Excel workbook or CSV file, or copy a spreadsheet block from Excel and paste it into a SQL editor."
                                   Classes="muted" TextAlignment="Center" />
                        <Button Content="Choose a source file"
                                Command="{Binding OpenFileForImportCommand}"
                                Classes="accent primary-action"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Classes="import-card" IsVisible="{Binding !IsSourceEmpty}">
                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Classes="card-title" Text="Columns and preview" />
                                <TextBlock Classes="card-subtitle"
                                           Text="Review detected types, override a type, then check the first rows." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="All as text"
                                        Command="{Binding ApplyAllAsTextCommand}"
                                        Classes="ghost-action" />
                                <Button Content="Revert to detected"
                                        Command="{Binding RevertAllToDetectedCommand}"
                                        Classes="ghost-action" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ValidationSummary}"
                                   IsVisible="{Binding !!ValidationSummary}"
                                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                   TextWrapping="Wrap" FontSize="11" Margin="0 4 0 0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" RowDefinitions="3*,Auto,4*" RowSpacing="10"
                      IsVisible="{Binding !IsSourceEmpty}">
                    <Border Grid.Row="0" Classes="import-card grid-card">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="panel-header">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="COLUMNS" FontSize="10" FontWeight="Bold"
                                                   Opacity="0.55" VerticalAlignment="Center" />
                                        <TextBlock Text="Click a type cell to override the detected type."
                                                   Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ColumnsInGrid.Count, StringFormat='{}{0} columns'}"
                                               Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      Classes="import-grid"
                                      IsReadOnly="False"
                                      ItemsSource="{Binding ColumnsInGrid}"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="False"
                                      Margin="4 0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" IsReadOnly="True"
                                                        Binding="{Binding ColumnName}" Width="2*" />
                                    <DataGridTextColumn Header="Detected type" IsReadOnly="True"
                                                        Binding="{Binding DetectedType}" Width="1.6*" />
                                    <DataGridTemplateColumn Header="Target type" IsReadOnly="False" Width="2.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:ColumnInGrid">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="6 0">
                                                    <TextBlock Text="{Binding SelectedType}" VerticalAlignment="Center" />
                                                    <Border IsVisible="{Binding IsOverridden}"
                                                            CornerRadius="8" Padding="6 1"
                                                            Background="{DynamicResource SystemAccentColorLight3Brush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="overridden" FontSize="10"
                                                                   Foreground="{DynamicResource SystemAccentColorBrush}" />
                                                    </Border>
                                                    <Button Content="Reset"
                                                            Command="{Binding ResetToDetectedCommand}"
                                                            IsVisible="{Binding IsOverridden}"
                                                            Classes="ghost-action"
                                                            FontSize="10"
                                                            Padding="4 0"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Revert this column to its detected type." />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate x:DataType="vm:ColumnInGrid">
                                                <ComboBox ItemsSource="{Binding AvailableChoices}"
                                                          SelectedItem="{Binding SelectedChoice}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TypeChoice">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Validation" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:ColumnInGrid">
                                                <TextBlock Text="{Binding ValidationError}"
                                                           IsVisible="{Binding HasValidationError}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="6 0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows"
                                  Background="Transparent" />

                    <Border Grid.Row="2" Classes="import-card grid-card">
                        <Grid RowDefinitions="Auto,*">
                            <Border Classes="panel-header">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold"
                                                   Opacity="0.55" VerticalAlignment="Center" />
                                        <TextBlock Text="First rows of the source file."
                                                   Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DetectionStatus}"
                                               IsVisible="{Binding !!DetectionStatus}"
                                               Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <DataGrid Name="previewDataGrid" Grid.Row="1"
                                      Classes="import-grid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MinHeight="80"
                                      Margin="4 0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="2" Classes="import-card" IsVisible="{Binding IsProgressVisible}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding ProgressStatus}" FontWeight="SemiBold" />
                        <TextBlock Text="Import progress and diagnostics"
                                   Classes="muted" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !!ResultSql}">
                        <Button Content="Copy SELECT"
                                Command="{Binding CopySelectCommand}"
                                Classes="ghost-action" />
                        <Button Content="Insert SELECT"
                                Command="{Binding InsertSelectIntoEditorCommand}"
                                Classes="ghost-action" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Height="4" />

                <Expander Grid.Row="2" Classes="import-expander" Header="Details">
                    <StackPanel Spacing="6">
                        <TextBox Text="{Binding ResultSql}"
                                 IsVisible="{Binding !!ResultSql}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, monospace"
                                 MaxHeight="90" />
                        <ListBox ItemsSource="{Binding ImportLog}"
                                 MaxHeight="130" MinHeight="50">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportLogRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Opacity="0.6" FontSize="11" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>
    </Grid>
</UserControl>
