<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustyBase.ViewModels"
        x:Class="JustyBase.Views.OtherDialogs.QuickOpenWindow"
        x:DataType="vm:QuickOpenViewModel"
        Title="Quick Open"
        Width="720"
        Height="460"
        MinWidth="480"
        MinHeight="280"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
	<Window.KeyBindings>
		<KeyBinding Gesture="Enter" Command="{Binding AcceptSelectionCommand}"/>
		<KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
	</Window.KeyBindings>
	<Window.Styles>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource SystemAccentColorBrush}"/>
		</Style>
	</Window.Styles>
	<Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
			BorderThickness="1"
			Padding="10,10,10,8">
		<Grid RowDefinitions="Auto,*,Auto">
			<TextBox x:Name="SearchBox"
					 Grid.Row="0"
					 PlaceholderText="Search SQL files…"
					 Text="{Binding Query}"
					 FontSize="16"
					 MinHeight="36"
					 AcceptsReturn="False"/>

			<ListBox x:Name="Results"
					 Grid.Row="1"
					 Margin="0,8,0,0"
					 ItemsSource="{Binding Entries}"
					 SelectedItem="{Binding SelectedEntry}"
					 BorderThickness="0"
					 Background="Transparent">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="vm:QuickOpenEntryViewModel">
						<Panel Background="Transparent">
							<!-- Header -->
							<TextBlock Text="{Binding HeaderText}"
									   IsVisible="{Binding IsHeader}"
									   FontWeight="Bold"
									   FontSize="12"
									   Opacity="0.7"
									   Margin="8,6,8,4"/>
							<!-- Hit row -->
							<Grid IsVisible="{Binding !IsHeader}"
								  ColumnDefinitions="*,Auto"
								  RowDefinitions="Auto,Auto"
								  Margin="10,6,10,6"
								  Background="Transparent">
								<TextBlock Grid.Row="0" Grid.Column="0"
										   Text="{Binding PrimaryText}"
										   TextTrimming="CharacterEllipsis"
										   FontSize="14"/>
								<TextBlock Grid.Row="0" Grid.Column="1"
										   Text="{Binding SecondaryText}"
										   Opacity="0.65"
										   FontSize="12"
										   Margin="12,0,0,0"
										   TextTrimming="CharacterEllipsis"
										   MaxWidth="280"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										   Text="{Binding Snippet}"
										   IsVisible="{Binding IsContent}"
										   Opacity="0.65"
										   FontFamily="Consolas, Cascadia Mono, monospace"
										   FontSize="12"
										   TextTrimming="CharacterEllipsis"
										   Margin="0,2,0,0"/>
							</Grid>
						</Panel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

			<TextBlock Grid.Row="2"
					   Text="{Binding HintText}"
					   Opacity="0.65"
					   FontSize="11"
					   Margin="2,8,2,0"/>
		</Grid>
	</Border>
</Window>
