<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:JustyBase.ViewModels.Tools"
             xmlns:sample="using:JustyBase.SqliteDriver.Samples"
             mc:Ignorable="d"
             d:DesignWidth="820" d:DesignHeight="560"
             x:DataType="vm:AddNewConnectionViewModel"
             x:CompileBindings="True"
             x:Class="JustyBase.Views.Tools.AddNewConnectionView">
    <UserControl.Styles>
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.fieldError">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource SystemAccentColor}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            Margin="8"
            MinWidth="640">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <StackPanel Grid.Row="0" Spacing="3">
                <TextBlock Text="Connection settings"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a database type, enter the details, then test the connection before saving."
                           Classes="muted"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="220,4,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBlock Text="Database type" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding DriverSearchText}"
                                 PlaceholderText="Search databases"
                                 HorizontalContentAlignment="Stretch"/>
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding VisibleDrivers}"
                                 SelectedItem="{Binding SelectedDriver, Mode=TwoWay}"
                                 AutomationProperties.Name="Database types">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionDriverOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,4">
                                        <Image Width="20" Height="20"
                                               Source="{Binding Id, Converter={StaticResource databaseIconConverter}}"/>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="4"/>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,0,4,0">
                        <ComboBox IsVisible="{Binding ShowExistings}"
                                  ItemsSource="{Binding ConnectionList}"
                                  SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                                  PlaceholderText="Select an existing connection">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Background="{DynamicResource ThemeControlHighlightMidBrush}"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Width="28" Height="28"
                                       Source="{Binding SelectedDriver.Id, Converter={StaticResource databaseIconConverter}}"/>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SelectedDriver.DisplayName, FallbackValue='Select a database type'}"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedDriver.Description}" Classes="muted"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Connection name" Classes="formLabel"/>
                        <TextBox Text="{Binding ConName}"
                                 PlaceholderText="e.g. Production PostgreSQL"
                                 ToolTip.Tip="A friendly name used in the database tree"/>
                        <TextBlock Text="{Binding NameError}" Classes="fieldError" IsVisible="{Binding HasNameError}"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding ServerLabel}" Classes="formLabel"/>
                                <TextBox Text="{Binding Server}"
                                          PlaceholderText="{Binding ServerWatermark}"/>
                                <TextBlock Text="{Binding ServerError}" Classes="fieldError" IsVisible="{Binding HasServerError}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" IsVisible="{Binding IsPortVisible}" Width="100">
                                <TextBlock Text="Port" Classes="formLabel"/>
                                <TextBox Text="{Binding Port}" PlaceholderText="Default"/>
                                <TextBlock Text="{Binding PortError}" Classes="fieldError" IsVisible="{Binding HasPortError}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding DatabaseLabel}" Classes="formLabel"/>
                        <TextBox Text="{Binding Database}" PlaceholderText="{Binding DatabaseWatermark}"/>
                        <TextBlock Text="{Binding DatabaseError}" Classes="fieldError" IsVisible="{Binding HasDatabaseError}"/>
                        <StackPanel IsVisible="{Binding IsFileDatabase}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="Open existing file"
                                    Command="{Binding OpenDatabaseFileCommand}"/>
                            <Button Content="Create new file"
                                    Command="{Binding CreateDatabaseFileCommand}"/>
                            <Button Content="Use :memory:"
                                    Command="{Binding UseMemoryDatabaseCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DatabaseFileHint}"
                                   IsVisible="{Binding IsFileDatabase}"
                                   Classes="muted"
                                   FontSize="11"/>

                        <Border IsVisible="{Binding IsAuthenticationVisible}"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,4,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Authentication" FontWeight="SemiBold"/>
                                <TextBlock Text="Credentials are stored in the encrypted application credentials file."
                                           Classes="muted" FontSize="11"/>
                                <TextBlock Text="Username" Classes="formLabel"/>
                                <TextBox Text="{Binding UserName}" PlaceholderText="Database user"/>
                                <TextBlock Text="{Binding UserNameError}" Classes="fieldError" IsVisible="{Binding HasUserNameError}"/>
                                <TextBlock Text="Password" Classes="formLabel"/>
                                <TextBox Text="{Binding Pass}" PasswordChar="*" PlaceholderText="Password"/>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsSqliteSampleVisible}"
                                BorderBrush="{DynamicResource SystemAccentColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Spacing="7">
                                <CheckBox Content="Create a sample database"
                                          IsChecked="{Binding CreateSampleDatabase}"/>
                                <ComboBox ItemsSource="{Binding SqliteSamplePacks}"
                                          SelectedItem="{Binding SelectedSqliteSamplePack}"
                                          IsEnabled="{Binding CreateSampleDatabase}"/>
                                <TextBlock Text="{Binding SelectedSqliteSampleDescription}" Classes="muted"/>
                                <ScrollViewer MaxHeight="150" IsEnabled="{Binding CreateSampleDatabase}">
                                    <ItemsControl ItemsSource="{Binding SqliteSampleObjects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SqliteSampleObjectOption">
                                                <CheckBox IsChecked="{Binding IsSelected}">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding IsConnectionTestVisible}"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding ConnectionTestStatus}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ConnectionTestDetails}" Classes="muted"/>
                                <ProgressBar IsVisible="{Binding IsTestingConnection}"
                                             IsIndeterminate="True"
                                             Height="4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Test connection"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding CanTest}"
                        Padding="14,7"/>
                <Button Content="Save"
                        Command="{Binding AddNewCommand}"
                        IsEnabled="{Binding CanSave}"
                        Padding="14,7"/>
                <Button Content="Clone"
                        Command="{Binding CloneConnectionCommand}"
                        IsVisible="{Binding ShowExistings}"
                        Padding="14,7"/>
                <Button Content="Delete"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding ShowExistings}"
                        Padding="14,7"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
