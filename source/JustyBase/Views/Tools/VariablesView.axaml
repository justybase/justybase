<UserControl x:Class="JustyBase.Views.Tools.VariablesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:JustyBase.ViewModels.Tools"
			 xmlns:m="using:JustyBase.Models.Tools"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="400"
             x:DataType="vm:VariablesViewModel">
  <Grid Focusable="True" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,5,5,4" ColumnSpacing="3">
          <TextBlock Text="VARIABLES" FontWeight="SemiBold" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="+" Padding="6,1" Click="Add_Click" ToolTip.Tip="Add variable"/>
          <Button Grid.Column="2" Content="−" Padding="6,1" Click="Remove_Click" ToolTip.Tip="Remove selected variable"/>
          <Button Grid.Column="3" Content="↻" Padding="6,1" Click="Refresh_Click" ToolTip.Tip="Refresh values"/>
      </Grid>
	  <DataGrid Name="variablesDataGrid" Grid.Row="1"
				AutoGenerateColumns="False"
				CanUserResizeColumns="True"
			    ItemsSource="{Binding VariableList}"
				SelectedItem="{Binding SelectedVariable}"
			    RowHeight="24"
			    HeadersVisibility="Column"
			    GridLinesVisibility="Horizontal"
				ToolTip.Tip="'delete'/'+' key to remove/add new variable"
				KeyDown="VariablesDataGrid_KeyDown"
				DoubleTapped="VariablesDataGrid_DoubleTapped">
		  <DataGrid.Columns>
			  <DataGridTemplateColumn Header="Variable" IsReadOnly="False" Width="Auto" >
				  <DataGridTemplateColumn.CellTemplate>
					  <DataTemplate DataType="m:VariableModel">
                          <StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
                              <TextBlock Text="◇" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                              <TextBlock Text="{Binding VariableName}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                          </StackPanel>
					  </DataTemplate>
				  </DataGridTemplateColumn.CellTemplate>
				  <DataGridTemplateColumn.CellEditingTemplate>
					  <DataTemplate DataType="m:VariableModel">
						  <TextBox Text="{Binding VariableName}"
						           VerticalContentAlignment="Stretch" VerticalAlignment="Stretch"
						           HorizontalAlignment="Stretch"  HorizontalContentAlignment="Stretch"
						           MinHeight="21" Height="21" FontSize="12" Margin="3 0" Padding="2"/>
					  </DataTemplate>
				  </DataGridTemplateColumn.CellEditingTemplate>
			  </DataGridTemplateColumn>
			  
			  <DataGridTemplateColumn Header="Value" IsReadOnly="False" Width="*" >
				  <DataGridTemplateColumn.CellTemplate>
					  <DataTemplate DataType="m:VariableModel">
						  <TextBlock Text="{Binding VariableComputedValue}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                     FontFamily="Consolas" FontSize="12" Margin="5,0" TextTrimming="CharacterEllipsis"/>
					  </DataTemplate>
				  </DataGridTemplateColumn.CellTemplate>
				  <DataGridTemplateColumn.CellEditingTemplate>
					  <DataTemplate DataType="m:VariableModel">
						  <TextBox Text="{Binding VariableComputedValue}"
						           VerticalContentAlignment="Stretch" VerticalAlignment="Stretch"
						           HorizontalAlignment="Stretch"  HorizontalContentAlignment="Stretch"
						           MinHeight="21" Height="21" FontSize="12" Margin="3 0" Padding="2"/>
					  </DataTemplate>
				  </DataGridTemplateColumn.CellEditingTemplate>
			  </DataGridTemplateColumn>
		  </DataGrid.Columns>
	  </DataGrid>
  </Grid>
</UserControl>
