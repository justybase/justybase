<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
    <ProjectReference Include="..\..\..\JustyBase.PluginCommon\JustyBase.PluginCommon.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
  </ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' == 'true'">
		<ProjectReference Include="$(JustyBaseLocalNetezzaDdlProject)" />
		<ProjectReference Include="$(JustyBaseLocalImportExportProject)" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
		<PackageReference Include="JustyBase.NetezzaDdl" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
		<PackageReference Include="JustyBase.ImportExport" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
	</ItemGroup>

</Project>
