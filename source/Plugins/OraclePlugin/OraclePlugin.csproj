<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Copyright>JustyBaseTeam</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <!--
      Oracle.ManagedDataAccess.Core 23.26.400 still resolves the vulnerable
      System.Security.Cryptography.Pkcs 8.0.1 transitively (GHSA-846f-f764-76mx,
      high; GHSA-2fmv-rv2c-59x7, moderate). Pin the patched framework package so
      the whole graph unifies on the .NET 11 build.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\JustyBase.PluginBase\JustyBase.PluginBase.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\..\JustyBase.PluginCommon\JustyBase.PluginCommon.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\Helpers\JustyBase.Helpers.Importers\JustyBase.Helpers.Importers.csproj">
			<!--<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>-->
		</ProjectReference>
	</ItemGroup>
</Project>
