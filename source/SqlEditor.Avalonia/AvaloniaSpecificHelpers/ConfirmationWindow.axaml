<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="400"
		Width="650" Height="420"
		MinWidth="480" MinHeight="300"
        x:Class="JustyBase.Views.ConfirmationWindow"
        Title="Tool Execution Confirmation"
        WindowDecorations="Full"
		UseLayoutRounding="True" 
		ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner">
	<Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SystemAccentColorLight3Brush}">
                <TextBlock Text="?" FontSize="19" Foreground="{DynamicResource SystemAccentColorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Name="titleLabel" Grid.Column="1" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap">Tool Execution Confirmation</TextBlock>
        </Grid>
		<Border Grid.Row="1" BorderBrush="{DynamicResource DockThemeBorderLowBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<TextBox Name="contentTextBlock" AcceptsReturn="True" IsReadOnly="True" 
						 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						 TextWrapping="Wrap" FontSize="13"
						 BorderBrush="Transparent" Background="Transparent"
						 >Message</TextBox>
			</ScrollViewer>
		</Border>
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Name="btnNo" MinWidth="88" Padding="14,6" IsCancel="True">No</Button>
			<Button Name="btnYes" MinWidth="88" Padding="14,6" Classes="accent" IsDefault="True">Yes</Button>
		</StackPanel>
	</Grid>
</Window>

