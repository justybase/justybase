<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="340"
		Width="600" Height="360"
		MinWidth="440" MinHeight="260"
        x:Class="JustyBase.Views.MessageWindow"
        Title="Message"
		WindowStartupLocation="CenterOwner"
        WindowDecorations="Full"
		UseLayoutRounding="True" 
		ShowInTaskbar="False">
	<Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SystemAccentColorLight3Brush}">
                <TextBlock Text="ℹ" FontSize="19" Foreground="{DynamicResource SystemAccentColorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Name="titleLabel" Grid.Column="1" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap">Information</TextBlock>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DockThemeBorderLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10">
            <TextBox Name="contentTextBlock" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13">Message Content</TextBox>
        </Border>
        <Button Name="tbOk" Grid.Row="2" HorizontalAlignment="Right" MinWidth="90"
                Classes="accent" IsDefault="True" IsCancel="True" Padding="14,6">OK</Button>
		</Grid>
</Window>
