<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	 <DefineConstants>AVALONIA</DefineConstants>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' == 'true'">
		<ProjectReference Include="$(JustyBaseLocalNetezzaProject)" />
		<ProjectReference Include="$(JustyBaseLocalNetezzaSqlParserProject)" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseLocalJustyBaseLibraries)' != 'true'">
        <PackageReference Include="JustyBase.Netezza" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
        <PackageReference Include="JustyBase.NetezzaSqlParser" Version="$(JustyBaseNetezzaLibsPackageVersion)" />
	</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustyBase.PluginCommon\JustyBase.PluginCommon.csproj" />
  </ItemGroup>
</Project>
